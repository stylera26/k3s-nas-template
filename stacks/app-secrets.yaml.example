# Copier en app-secrets.yaml, remplir les valeurs, puis :
#   kubectl apply -f app-secrets.yaml
#
# NE PAS commiter ce fichier — il est dans .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: APP_NAME-secrets
  namespace: APP_NAME
type: Opaque
stringData:
  mongodb_root_username: "CHANGE_ME"
  mongodb_root_password: "CHANGE_ME"
  mongodb_uri:           "mongodb://CHANGE_ME:CHANGE_ME@mongodb:27017/APP_NAME?authSource=admin"
  jwt_secret:            "CHANGE_ME_min_32_chars"
  minio_access_key:      "CHANGE_ME"
  minio_secret_key:      "CHANGE_ME"